<%- include("./include/_header") %>

<!-- Main -->
<main id="site-main">
  <div class="button-box">
    <a href="/contacts/add" class="btn btn-light">
      <i class="fa-solid fa-user-plus"></i> 연락처 추가
    </a>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>이름</th>
        <th>메일 주소</th>
        <th>전화번호</th>
        <th>&nbsp;</th>
      </tr>
    </thead>
    <tbody>
        <% result.forEach(contact => { %>
          <tr>
            <td><%= contact.name %></td>
            <td><%= contact.email %></td>
            <td><%= contact.phone %></td>
            <td>
              <!-- 수정 -->
              <a href="#" class="btn update" title="수정">
                <i class="fas fa-pencil-alt"></i>
              </a>

              <!-- 삭제 -->
              <a href="#" class="btn delete" title="삭제">
                <i class="fas fa-times"></i>
              </a>
            </td>
          </tr>
        <% }); %>
    </tbody>
  </table>
</main>
<!-- /Main -->

<%- include("./include/_footer") %>
